{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The contact form's backend. The site reaches it through its service binding only: no public
  // address, no previews.
  "name": "maars-dairy-farms-www-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  // Enquiries. 
  "d1_databases": [{"binding":"DB","database_name":"maars-dairy-farms-www-enquiries","database_id":"32b829bf-19a4-4ece-9fa7-53ec34a5dd81","migrations_dir":"migrations"}],
  "vars": {
    "SITE_NAME": "MAARS Farms",
    "SITE_ID": "maars-dairy-farms",
    // Where enquiries are emailed: keep it the same as forms.inbox in sites/main/site.config.ts.
    "FORM_INBOX": "dev.darazhar@gmail.com",
    "GATEWAY_URL": "https://gateway.craeft.org"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, FORMS_KEY.
}
